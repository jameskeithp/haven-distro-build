# HAVEN: correct Debian bookworm security repository.
# live-build 3.0.x hardcodes the pre-bookworm suite name "bookworm/updates",
# which no longer exists. Security is disabled in lb config (--security false)
# and provided here instead with the real bookworm-security suite.
deb http://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
