#!/bin/sh
set -e
# HAVEN live-build configuration wrapper.
# REFERENCE ONLY - do NOT execute directly and do NOT make executable:
# live-build 3.0.x re-executes an executable auto/config from inside
# lb config, causing infinite recursion. run-iso-build.sh inlines these
# same flags into a direct lb config call. Keep the two in sync.
# Source: Phase 3, Step 2 of FLAGSHIP-LINUX-DISTRO-BUILD-GUIDE.md.
#
# NOTE (2026-10-17): flags below target live-build 3.0.x as shipped by
# Ubuntu 24.04. The 4.x (Debian fork) names differ: --bootloaders (plural,
# with grub-efi), --image-name, --updates. On 3.0.x --bootloader takes a
# single value (grub|syslinux|yaboot); UEFI boot is a follow-up item.

lb config \
  --distribution bookworm \
  --archive-areas "main contrib non-free non-free-firmware" \
  --debian-installer live \
  --bootloader syslinux \
  --iso-application "HAVEN" \
  --iso-publisher "Black Haven LLC" \
  --iso-volume "HAVEN_2026" \
  --security true \
  --backports false \
  --firmware-binary true \
  --firmware-chroot true
